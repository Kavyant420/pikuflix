# =============================================================================
# PikuFlix — Environment variables
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
#   cp .env.example .env
# =============================================================================

# --- Server -----------------------------------------------------------------
# Port the Express server listens on.
PORT=3000
# "development" or "production". In production, secure cookies + strict CORS.
NODE_ENV=development

# --- Authentication ---------------------------------------------------------
# Secret used to sign JWTs. Generate a strong random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
# How long a session lasts (vercel/ms-style string or seconds).
JWT_EXPIRES_IN=7d

# --- TMDB (The Movie Database) ----------------------------------------------
# Get a free key at https://www.themoviedb.org/settings/api
# The key is used ONLY server-side (proxied) and is never exposed to the browser.
TMDB_API_KEY=your_tmdb_api_key_here
# Optional: a v4 read access token can be used instead of the v3 key.
# TMDB_ACCESS_TOKEN=

# --- AI assistant (Pollinations) --------------------------------------------
# Public text generation endpoint. Override only if you self-host.
POLLINATIONS_BASE_URL=https://text.pollinations.ai

# --- Streaming embed provider ----------------------------------------------
# Base URL for the cinesrc.st embed system (used by the player in Phase 2).
CINESRC_BASE_URL=https://cinesrc.st

# --- CORS -------------------------------------------------------------------
# Comma-separated list of allowed origins when the API is called cross-origin.
# Leave empty to allow same-origin only in production.
ALLOWED_ORIGINS=http://localhost:3000
