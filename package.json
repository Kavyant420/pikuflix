{
  "name": "pikuflix",
  "version": "2.0.0",
  "description": "PikuFlix — a professional, Netflix-style movie streaming web application with TMDB catalog, cinesrc.st player, JWT auth and an AI assistant.",
  "type": "module",
  "main": "server/index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "check": "node --check server/index.js"
  },
  "keywords": [
    "streaming",
    "netflix",
    "tmdb",
    "express",
    "jwt"
  ],
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0"
  }
}
